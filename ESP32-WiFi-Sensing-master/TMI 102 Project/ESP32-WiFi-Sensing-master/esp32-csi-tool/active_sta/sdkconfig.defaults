# ESP-IDF SDK Configuration Defaults for Active STA (Station Transmitter)
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_WIFI_CHANNEL=6
CONFIG_ESP_WIFI_SSID="ESP32_CSI"
CONFIG_ESP_WIFI_PASSWORD="mypassword"
CONFIG_PACKET_RATE=100
CONFIG_SHOULD_COLLECT_CSI=n
CONFIG_FREERTOS_HZ=1000
